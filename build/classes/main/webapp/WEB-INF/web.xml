<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- ================= WELCOME FILE ================= -->
    <welcome-file-list>
        <welcome-file>admin-login.jsp</welcome-file>
    </welcome-file-list>

    <!-- ================= SESSION TIMEOUT ================= -->
    <!-- BUG FIX: no session-timeout was configured anywhere (defaulted to
         the container's own default, commonly 30 minutes but not guaranteed).
         Explicitly set to 15 minutes so an idle session (admin or student)
         expires predictably. -->
    <session-config>
        <session-timeout>15</session-timeout>
    </session-config>


    <!-- ================= ADD COMPANY ================= -->
    <servlet>
        <servlet-name>AddCompanyServlet</servlet-name>
        <servlet-class>controller.AddCompanyServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddCompanyServlet</servlet-name>
        <url-pattern>/AddCompanyServlet</url-pattern>
    </servlet-mapping>


    <!-- ================= ADD JOB ================= -->
    <servlet>
        <servlet-name>AddJobServlet</servlet-name>
        <servlet-class>controller.AddJobServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddJobServlet</servlet-name>
        <url-pattern>/AddJobServlet</url-pattern>
    </servlet-mapping>


    <!-- ================= DELETE JOB ================= -->
    <servlet>
        <servlet-name>DeleteJobServlet</servlet-name>
        <servlet-class>controller.DeleteJobServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DeleteJobServlet</servlet-name>
        <url-pattern>/DeleteJobServlet</url-pattern>
    </servlet-mapping>


    <!-- ================= UPDATE APPLICATION STATUS ================= -->
    <servlet>
        <servlet-name>UpdateApplicationStatusServlet</servlet-name>
        <servlet-class>controller.UpdateApplicationStatusServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UpdateApplicationStatusServlet</servlet-name>
        <url-pattern>/UpdateApplicationStatusServlet</url-pattern>
    </servlet-mapping>

</web-app>
